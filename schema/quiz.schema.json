{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ai-Gora/aigora/schema/quiz.schema.json",
  "title": "Aigora quiz file",
  "type": "object",
  "additionalProperties": false,
  "required": ["article", "questions"],
  "properties": {
    "article": { "type": "string", "pattern": "^aig-[0-9]{6}$" },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "prompt", "answer", "ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^q[0-9]+$" },
          "type": { "enum": ["single", "multi", "true_false", "order", "fill"] },
          "prompt": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "answer": {},
          "explain": { "type": "string" },
          "ref": { "type": "string", "pattern": "^[a-z0-9-]+#[a-z0-9-]+$" },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
