{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ai-Gora/aigora/schema/topic.schema.json",
  "title": "Aigora topic file",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "not": { "const": "index" } },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "parent": { "type": ["string", "null"] },
    "related": { "type": "array", "items": { "type": "string" } },
    "i18n": {
      "description": "Optional translations keyed by language code (en is title/description). Pages in that language use them; missing fields fall back to English.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]{2}$", "not": { "const": "en" } },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": { "title": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
